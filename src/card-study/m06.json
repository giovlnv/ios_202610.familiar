  "summary": {
    "pt": [
      "Os Enamorados falam de amor, desejo e escolha.",
      "Eles representam a união que tira o ego do isolamento.",
      "O foco deles é: amar por escolha, unindo corpo e consciência."
    ],
    "en": [
      "The Lovers speak of love, desire and choice.",
      "They stand for the union that frees the ego from isolation.",
      "Their focus: loving by choice, uniting body and awareness."
    ]
  },
  "planes": [
    {
      "id": "spiritual",
      "title": {
        "pt": "Plano Espiritual",
        "en": "Spiritual"
      },
      "bullets": {
        "pt": [
          "O amor como caminho",
          "Um vislumbre de algo maior",
          "Unir os opostos dentro de si"
        ],
        "en": [
          "Love as a path",
          "A glimpse of something greater",
          "Uniting the opposites within"
        ]
      },
      "line": {
        "pt": "“A dois, vejo o que sozinho não via.”",
        "en": "“Together, I see what I couldn't see alone.”"
      }
    },
