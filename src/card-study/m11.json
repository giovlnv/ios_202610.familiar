  "summary": {
    "pt": [
      "A Justiça fala de verdade, equilíbrio e responsabilidade.",
      "Ela representa o olhar honesto sobre as próprias escolhas.",
      "O foco dela é: entender o passado para agir melhor agora."
    ],
    "en": [
      "Justice speaks of truth, balance and responsibility.",
      "She stands for an honest look at your own choices.",
      "Her focus: understanding the past to act better now."
    ]
  },
