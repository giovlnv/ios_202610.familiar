  "summary": {
    "pt": [
      "A Lua fala de sonhos, medos e instintos antigos.",
      "Ela representa o inconsciente que vem à tona com força.",
      "O foco dela é: atravessar a noite sem se perder nela."
    ],
    "en": [
      "The Moon speaks of dreams, fears and age-old instincts.",
      "She stands for the unconscious rising powerfully to the surface.",
      "Her focus: crossing the night without getting lost in it."
    ]
  },
