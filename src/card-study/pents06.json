  "summary": {
    "pt": [
      "O Seis de Ouros fala de generosidade, troca e equilíbrio.",
      "Ele representa o dar e receber em que todos ganham.",
      "O foco dele é: dar o que o outro pode receber, e saber receber."
    ],
    "en": [
      "The Six of Pentacles speaks of generosity, exchange and balance.",
      "It stands for giving and receiving in which everyone gains.",
      "Its focus: giving what the other can receive, and knowing how to receive."
    ]
  },
