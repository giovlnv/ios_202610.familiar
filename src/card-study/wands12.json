  "summary": {
    "pt": [
      "O Cavaleiro de Paus fala de ação, aventura e movimento.",
      "Ele representa a energia do fogo que parte para o mundo.",
      "O foco dele é: agir com propósito para não se dispersar."
    ],
    "en": [
      "The Knight of Wands speaks of action, adventure and movement.",
      "He stands for fire energy setting out into the world.",
      "His focus: acting with purpose so as not to scatter."
    ]
  },
