  "summary": {
    "pt": [
      "O Cavaleiro de Espadas fala de coragem, ímpeto e confronto.",
      "Ele representa a mente que avança contra qualquer obstáculo.",
      "O foco dele é: comprometer-se e persistir, sem virar fanático."
    ],
    "en": [
      "The Knight of Swords speaks of courage, drive and confrontation.",
      "He stands for the mind charging against any obstacle.",
      "His focus: committing and persisting without turning fanatical."
    ]
  },
