  "summary": {
    "pt": [
      "O Cinco de Ouros fala de carência, dificuldade e solidariedade.",
      "Ele representa quem atravessa a neve sem ver a luz ao lado.",
      "O foco dele é: pedir e aceitar ajuda, e unir forças."
    ],
    "en": [
      "The Five of Pentacles speaks of lack, hardship and solidarity.",
      "It stands for those crossing the snow without seeing the light beside them.",
      "Its focus: asking for and accepting help, and joining forces."
    ]
  },
  "planes": [
    {
      "id": "spiritual",
      "title": {
        "pt": "Plano Espiritual",
        "en": "Spiritual"
      },
      "bullets": {
        "pt": [
          "Deixe Deus partilhar sua falta",
          "Quando as instituições não ajudam",
          "Caminho próprio, sem doutrina"
        ],
        "en": [
          "Let God share in your lack",
          "When institutions can't help",
          "Your own path, without doctrine"
        ]
      },
      "line": {
        "pt": "“Até na falta há algo a partilhar.”",
        "en": "“Even in lack there's something to share.”"
      }
    },
    {
