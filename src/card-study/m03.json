  "summary": {
    "pt": [
      "A Imperatriz fala de amor, natureza e fertilidade.",
      "Ela representa a vida vivida pelos sentidos e pelo sentimento.",
      "O foco dela é: cuidar, nutrir e deixar florescer."
    ],
    "en": [
      "The Empress speaks of love, nature and fruitfulness.",
      "She stands for life lived through the senses and feeling.",
      "Her focus: caring, nourishing and letting things bloom."
    ]
  },
