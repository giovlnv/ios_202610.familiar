  "summary": {
    "pt": [
      "O Julgamento fala de despertar, chamado e renascimento.",
      "Ele representa a mudança que, por dentro, já aconteceu.",
      "O foco dele é: atender o chamado e deixar o passado em paz."
    ],
    "en": [
      "Judgement speaks of awakening, calling and rebirth.",
      "It stands for a change that has already happened inside.",
      "Its focus: answering the call and letting the past rest."
    ]
  },
