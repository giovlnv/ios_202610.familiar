        "en": [
          "A complete change of mind",
          "The bond between the divine and the universe",
          "After death, resurrection"
        ]
      },
      "line": {
        "pt": "“O que você busca é o que busca você.”",
        "en": "“What you seek is what is seeking you.”"
      }
    },
