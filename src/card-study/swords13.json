  "summary": {
    "pt": [
      "A Rainha de Espadas fala de sabedoria, clareza e verdade.",
      "Ela representa a dor enfrentada e transformada em lucidez.",
      "O foco dela é: decidir com clareza e limites amorosos."
    ],
    "en": [
      "The Queen of Swords speaks of wisdom, clarity and truth.",
      "She stands for sorrow faced and turned into lucidity.",
      "Her focus: deciding clearly, with loving limits."
    ]
  },
