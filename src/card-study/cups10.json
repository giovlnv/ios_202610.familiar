  "summary": {
    "pt": [
      "O Dez de Copas fala de família, amor e plenitude.",
      "Ele representa a alegria da vida espalhada pelo céu.",
      "O foco dele é: reconhecer e celebrar a felicidade que está aqui."
    ],
    "en": [
      "The Ten of Cups speaks of family, love and fullness.",
      "It stands for the joy of life spread across the sky.",
      "Its focus: recognising and celebrating the happiness that's here."
    ]
