  "summary": {
    "pt": [
      "O Rei de Espadas fala de autoridade, julgamento e verdade.",
      "Ele representa o intelecto a serviço da justiça e da ação.",
      "O foco dele é: questionar os próprios motivos e manter-se honesto."
    ],
    "en": [
      "The King of Swords speaks of authority, judgement and truth.",
      "He stands for intellect serving justice and action.",
      "His focus: questioning his own motives and staying honest."
    ]
  },
