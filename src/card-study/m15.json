  "summary": {
    "pt": [
      "O Diabo fala de sombra, dependência e desejos escondidos.",
      "Ele representa o que estava no escuro vindo à luz.",
      "O foco dele é: ver as correntes para poder soltá-las."
    ],
    "en": [
      "The Devil speaks of shadow, dependency and hidden desires.",
      "He stands for what was in the dark coming into the light.",
      "His focus: seeing the chains so you can slip them off."
    ]
  },
