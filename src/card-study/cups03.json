  "summary": {
    "pt": [
      "O Três de Copas fala de festa, amizade e colheita.",
      "Ele representa a alegria partilhada em grupo.",
      "O foco dele é: celebrar junto sem perder a si mesma."
    ],
    "en": [
      "The Three of Cups speaks of celebration, friendship and harvest.",
      "It stands for joy shared in a group.",
      "Its focus: celebrating together without losing yourself."
    ]
  },
