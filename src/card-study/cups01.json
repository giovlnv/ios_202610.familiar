  "summary": {
    "pt": [
      "O Ás de Copas fala de amor, alegria e vida interior.",
      "Ele representa o presente da emoção que transborda.",
      "O foco dele é: receber o amor e deixar os sentimentos fluírem."
    ],
    "en": [
      "The Ace of Cups speaks of love, joy and inner life.",
      "It stands for the gift of emotion overflowing.",
      "Its focus: receiving love and letting feelings flow."
    ]
  },
