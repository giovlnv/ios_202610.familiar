  "summary": {
    "pt": [
      "O Imperador fala de ordem, autoridade e estrutura.",
      "Ele representa a força que organiza a vida e defende o seu território.",
      "O foco dele é: ser senhor da própria vida, sem endurecer."
    ],
    "en": [
      "The Emperor speaks of order, authority and structure.",
      "He stands for the strength that organises life and defends its ground.",
      "His focus: being master of your own life without turning to stone."
    ]
  },
  "planes": [
    {
      "id": "spiritual",
      "title": {
        "pt": "Plano Espiritual",
        "en": "Spiritual"
      },
      "bullets": {
        "pt": [
          "Suportar a si mesmo",
          "Estabilidade que permite crescer",
          "O espírito que ordena a natureza"
        ],
        "en": [
          "Being able to stand yourself",
          "Stability that allows growth",
          "Spirit bringing order to nature"
        ]
      },
      "line": {
        "pt": "“Quem governa a si mesmo não precisa de trono.”",
        "en": "“Whoever rules themselves needs no throne.”"
      }
    },
