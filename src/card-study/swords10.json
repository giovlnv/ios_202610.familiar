        "en": [
          "It is what it is, says Love",
          "The end of idols and models",
          "Spirituality as a fountain of youth"
        ]
      },
      "line": {
        "pt": "“Nada do passado me prepara inteiro para o que vem.”",
        "en": "“Nothing from the past fully prepares me for what's next.”"
      }
    },
