  "summary": {
    "pt": [
      "A Rainha de Copas fala de amor, intuição e criação.",
      "Ela representa a imaginação guiada com consciência e amor.",
      "O foco dela é: confiar na voz interior e dar forma aos sonhos."
    ],
    "en": [
      "The Queen of Cups speaks of love, intuition and creation.",
      "She stands for imagination guided by awareness and love.",
      "Her focus: trusting her inner voice and giving dreams a form."
    ]
