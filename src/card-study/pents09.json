  "summary": {
    "pt": [
      "O Nove de Ouros fala de prosperidade, disciplina e autoconsciência.",
      "Ele representa o florescer de quem se construiu com cuidado.",
      "O foco dele é: saber o que importa e colher com gratidão."
    ],
    "en": [
      "The Nine of Pentacles speaks of prosperity, discipline and self-awareness.",
      "It stands for the blossoming of someone who built herself with care.",
      "Its focus: knowing what matters and harvesting with gratitude."
    ]
  },
