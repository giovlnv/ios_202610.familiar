  "summary": {
    "pt": [
      "O Quatro de Espadas fala de descanso, retiro e recuperação.",
      "Ele representa a mente em pausa para se curar.",
      "O foco dele é: recolher-se para voltar mais forte."
    ],
    "en": [
      "The Four of Swords speaks of rest, retreat and recovery.",
      "It stands for the mind pausing to heal.",
      "Its focus: withdrawing in order to come back stronger."
    ]
  },
