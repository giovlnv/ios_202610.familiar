  "summary": {
    "pt": [
      "O Ás de Ouros fala de talento, riqueza e segurança.",
      "Ele representa o presente concreto da terra e da vida.",
      "O foco dele é: pôr os talentos para render e ousar."
    ],
    "en": [
      "The Ace of Pentacles speaks of talent, wealth and security.",
      "It stands for the tangible gift of earth and life.",
      "Its focus: putting your talents to work and daring."
    ]
  },
