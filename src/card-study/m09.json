        "en": [
          "Your own path to God",
          "Living in the presence of the divine",
          "The inner light that guides"
        ]
      },
      "line": {
        "pt": "“Onde estou, você também pode estar.”",
        "en": "“Where I am, you can be too.”"
      }
    },
