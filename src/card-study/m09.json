      "title": {
        "pt": "Plano Material (Trabalho & Dinheiro)",
        "en": "Material (Work & Money)"
      },
      "bullets": {
        "pt": [
          "Resolver hoje, não amanhã",
          "Soluções que duram",
          "Pagar dívidas, de dinheiro e morais"
