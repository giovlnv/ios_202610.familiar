  "summary": {
    "pt": [
      "O Dois de Copas fala de amor, amizade e união.",
      "Ele representa o encontro de duas almas que se completam.",
      "O foco dele é: unir sem se reduzir à metade de alguém."
    ],
    "en": [
      "The Two of Cups speaks of love, friendship and union.",
      "It stands for two souls meeting and completing each other.",
      "Its focus: joining without shrinking into someone's other half."
    ]
  },
