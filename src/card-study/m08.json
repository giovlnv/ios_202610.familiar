  "summary": {
    "pt": [
      "A Força fala de coragem, paixão e paz interior.",
      "Ela representa os instintos acolhidos e guiados com amor.",
      "O foco dela é: estar inteira no momento, sem ser dominada."
    ],
    "en": [
      "Strength speaks of courage, passion and inner peace.",
      "She stands for instincts welcomed and guided with love.",
      "Her focus: being fully present without being overpowered."
    ]
  },
