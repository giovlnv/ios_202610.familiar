  "summary": {
    "pt": [
      "O Mago fala de vontade, criação e consciência do próprio poder.",
      "Ele representa a energia que desce do alto e vira algo concreto.",
      "O foco dele é: agir em vez de só reagir."
    ],
    "en": [
      "The Magician speaks of will, creation and awareness of one's own power.",
      "He stands for energy that comes down from above and becomes something real.",
      "His focus: acting instead of only reacting."
    ]
  },
  "planes": [
    {
      "id": "spiritual",
      "title": {
        "pt": "Plano Espiritual",
        "en": "Spiritual"
      },
      "bullets": {
        "pt": [
          "Ser canal entre céu e terra",
          "Unidade consigo, com Deus e o mundo",
          "O mago interior guia a jornada"
        ],
        "en": [
          "Being a channel between heaven and earth",
          "Oneness with self, God and the world",
          "The inner magician guides the journey"
        ]
      },
      "line": {
        "pt": "“A força não é minha, mas passa por mim.”",
        "en": "“The power isn't mine, but it flows through me.”"
      }
    },
    {
      "id": "material",
      "title": {
        "pt": "Plano Material (Trabalho & Dinheiro)",
        "en": "Material (Work & Money)"
      },
      "bullets": {
        "pt": [
          "Inspiração para um projeto novo",
          "Primeiros passos concretos",
          "Suas ideias são sua semente"
        ],
        "en": [
          "Inspiration for a new project",
          "The first concrete steps",
          "Your ideas are your seed corn"
        ]
      },
      "line": {
        "pt": "“Potencial só existe quando vira algo.”",
        "en": "“Potential only exists once it becomes something.”"
      }
    },
    {
      "id": "mental",
      "title": {
        "pt": "Plano Mental",
        "en": "Mental"
      },
      "bullets": {
        "pt": [
          "Vontade focada num objetivo",
          "Imaginação que cria realidade",
          "Separar as partes para ver o todo"
        ],
        "en": [
          "Will focused on one goal",
          "Imagination that creates reality",
          "Separating the parts to see the whole"
        ]
      },
      "line": {
        "pt": "“Saber o que quer já é metade da magia.”",
        "en": "“Knowing what you want is half the magic.”"
      }
    },
    {
      "id": "physical",
      "title": {
        "pt": "Plano Físico / Saúde",
        "en": "Physical / Health"
      },
      "bullets": {
        "pt": [
