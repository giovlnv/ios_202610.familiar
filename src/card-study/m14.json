  "summary": {
    "pt": [
      "A Temperança fala de equilíbrio, medida e harmonia.",
      "Ela representa a mistura dos opostos até a vida fluir.",
      "O foco dela é: agir na medida certa, momento a momento."
    ],
    "en": [
      "Temperance speaks of balance, measure and harmony.",
      "She stands for blending opposites until life flows.",
      "Her focus: acting in the right measure, moment by moment."
    ]
  },
