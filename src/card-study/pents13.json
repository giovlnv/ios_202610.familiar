  "summary": {
    "pt": [
      "A Rainha de Ouros fala de cuidado, abundância e confiança.",
      "Ela representa a união amorosa com a natureza e a vida diária.",
      "O foco dela é: cuidar do essencial e confiar em si."
    ],
    "en": [
      "The Queen of Pentacles speaks of care, abundance and confidence.",
      "She stands for a loving bond with nature and daily life.",
      "Her focus: tending to the essentials and trusting herself."
    ]
  },
