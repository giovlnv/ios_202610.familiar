  "summary": {
    "pt": [
      "O Dois de Paus fala de iniciativa, domínio e escolha.",
      "Ele representa o sucesso que pode virar muralha.",
      "O foco dele é: decidir o rumo e seguir com toda a força."
    ],
    "en": [
      "The Two of Wands speaks of initiative, mastery and choice.",
      "It stands for success that can turn into a wall.",
      "Its focus: deciding the way and going at it with full strength."
    ]
