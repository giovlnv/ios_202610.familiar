  "summary": {
    "pt": [
      "O Pajem de Espadas fala de curiosidade, vigilância e ideias.",
      "Ele representa a mente jovem e alerta que observa do alto.",
      "O foco dele é: buscar clareza sem perder o contato com a vida."
    ],
    "en": [
      "The Page of Swords speaks of curiosity, vigilance and ideas.",
      "He stands for the young, alert mind watching from above.",
      "His focus: seeking clarity without losing touch with life."
    ]
  },
