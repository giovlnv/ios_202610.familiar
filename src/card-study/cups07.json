  "summary": {
    "pt": [
      "O Sete de Copas fala de sonhos, desejos e ilusões.",
      "Ele representa a imaginação que ainda não tocou o chão.",
      "O foco dele é: separar o joio do trigo e escolher."
    ],
    "en": [
      "The Seven of Cups speaks of dreams, wishes and illusions.",
      "It stands for imagination that hasn't touched the ground yet.",
      "Its focus: separating wheat from chaff, and choosing."
    ]
  },
