      "bullets": {
        "pt": [
          "Medo de arriscar, cautela demais",
          "Imprudência e planos malucos",
          "Ingenuidade e talentos desperdiçados"
        ],
        "en": [
          "Fear of risk, too much caution",
          "Recklessness and crazy schemes",
          "Naivety and wasted talents"
        ]
      },
      "line": {
        "pt": "“Coragem sem o momento certo vira descuido.”",
        "en": "“Courage without the right moment turns into carelessness.”"
