        "en": [
          "Spirit in search of experience",
          "The power of now",
          "Entering the world of the archetypes"
        ]
      },
      "line": {
        "pt": "“A jornada começa quando você aceita não saber.”",
        "en": "“The journey begins when you accept not knowing.”"
      }
    },
    {
      "id": "material",
      "title": {
        "pt": "Plano Material (Trabalho & Dinheiro)",
