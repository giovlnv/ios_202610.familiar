  "summary": {
    "pt": [
      "O Ás de Espadas fala de clareza, verdade e força mental.",
      "Ele representa a mente que atravessa a ilusão.",
      "O foco dele é: ver com clareza e agir com consciência."
    ],
    "en": [
      "The Ace of Swords speaks of clarity, truth and mental strength.",
      "It stands for the mind that pierces illusion.",
      "Its focus: seeing clearly and acting with awareness."
    ]
  },
