  "summary": {
    "pt": [
      "O Cavaleiro de Ouros fala de trabalho, responsabilidade e paciência.",
      "Ele representa quem avança devagar e com firmeza.",
      "O foco dele é: trabalhar com constância sem esquecer por quê."
    ],
    "en": [
      "The Knight of Pentacles speaks of work, responsibility and patience.",
      "He stands for someone who moves slowly and steadily.",
      "His focus: working steadily without forgetting why."
    ]
  },
